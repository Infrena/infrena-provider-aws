#!/usr/bin/env bash
# fetch-models: download the Smithy JSON models the spike's smithyinvoke tests read. They are the models
# aws-sdk-go-v2 generates its clients from (codegen/sdk-codegen/aws-models), and are not committed.
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p smithyinvoke/testdata
for m in ec2; do
  gh api -H "Accept: application/vnd.github.raw" "repos/aws/aws-sdk-go-v2/contents/codegen/sdk-codegen/aws-models/$m.json" > "smithyinvoke/testdata/$m.json"
done
ls -la smithyinvoke/testdata
